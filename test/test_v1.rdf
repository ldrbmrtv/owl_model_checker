    <!-- http://test#external_staircase_b -->

    <owl:NamedIndividual rdf:about="http://test#external_staircase_b">
        <rdf:type rdf:resource="http://test#EscapeRoute"/>
        <rdf:type rdf:resource="http://test#ExternalStaircase"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://test#connects"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:oneOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://test#storey_0"/>
                            <rdf:Description rdf:about="http://test#storey_1"/>
                            <rdf:Description rdf:about="http://test#storey_2"/>
                            <rdf:Description rdf:about="http://test#storey_3"/>
                        </owl:oneOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://test#in"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Nothing"/>
            </owl:Restriction>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://test#isConnectedTo"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Nothing"/>
            </owl:Restriction>
        </rdf:type>
        <connects rdf:resource="http://test#storey_0"/>
        <connects rdf:resource="http://test#storey_1"/>
        <connects rdf:resource="http://test#storey_2"/>
        <connects rdf:resource="http://test#storey_3"/>
    </owl:NamedIndividual>
    


