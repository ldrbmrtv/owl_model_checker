    <owl:Class rdf:about="http://test#SeparateStairwell"/>
    


    <!-- http://test#Storey -->

    <owl:Class rdf:about="http://test#Storey"/>
    


    <!-- http://test#UsageUnit -->

    <owl:Class rdf:about="http://test#UsageUnit"/>
    


